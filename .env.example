# Supabase project URL and publishable/anon key are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only optional login alias: the existing administrator's Auth email.
# Never prefix with NEXT_PUBLIC_; missing configuration disables only "admin".
WHY_BOX_ADMIN_AUTH_EMAIL=

# Server-only AI settings. Keep disabled until migration, model and live-call approval.
OPENAI_CONTEXT_DRAFT_ENABLED=false
OPENAI_API_KEY=
OPENAI_CONTEXT_DRAFT_MODEL=

# Keep sentence refinement disabled until it is explicitly approved.
OPENAI_SENTENCE_REFINEMENT_ENABLED=false
# Candidate only: model access and one live validation need separate approval.
OPENAI_SENTENCE_REFINEMENT_MODEL=gpt-6-astra

# Server-only Question Generation model; independent of Context Draft.
# No live validation is authorized by setting this variable.
# There is no ENABLED flag for initial generation: a key plus model permits calls.
OPENAI_QUESTION_GENERATION_MODEL=gpt-6-astra

# Separate single-question regeneration; requires approved new migration and live validation.
OPENAI_QUESTION_REGENERATION_ENABLED=false
OPENAI_QUESTION_REGENERATION_MODEL=gpt-6-astra

# Active participants only, on their own sessions. Enable after migration and rollout approval.
# No UUID/code allowlist is used; legacy OPENAI_QUESTION_FOLLOWUP_ALLOWED_USER_IDS is ignored.
OPENAI_QUESTION_FOLLOWUP_ENABLED=false
OPENAI_QUESTION_FOLLOWUP_MODEL=gpt-6-astra

# Enable only after the image-deletion migration and remote verification.
SESSION_IMAGE_DELETION_ENABLED=false

# TEST-only deterministic briefing provider. Never enable in Vercel Production.
SESSION_BRIEFING_MOCK_ENABLED=false

# Server-only live briefing. Enable only after DB rollout and separate live-call approval.
OPENAI_SESSION_BRIEFING_ENABLED=false
OPENAI_SESSION_BRIEFING_MODEL=

# TEST credentials belong in the ignored .env.storage-test.local file only:
# SUPABASE_TEST_URL, SUPABASE_TEST_PUBLISHABLE_KEY,
# SUPABASE_TEST_SERVICE_ROLE_KEY, SUPABASE_TEST_DATABASE_URL.
# Never add these or WHY_BOX_TEST_*/WHY_BOX_RESEARCHER_* settings to Production.
